# Rendered at container startup by the official nginx entrypoint, which runs
# envsubst over every *.template file in /etc/nginx/templates/ and writes the
# result to /etc/nginx/conf.d/. ${NAVIDROME_URL} comes from the container
# environment (see docker-compose.yml / README).
server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hashed build assets can be cached aggressively.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Subsonic REST API (auth, browsing, cover art, audio streaming, ...) is
    # proxied straight through to the real Navidrome server. Doing this
    # server-side means the browser only ever talks to this one origin, so
    # there are no CORS issues and NAVIDROME_URL never needs to be reachable
    # directly from the client's network.
    location /rest/ {
        proxy_pass ${NAVIDROME_URL}/rest/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Needed for correct SNI/cert validation when NAVIDROME_URL is https://
        # and the upstream sits behind name-based routing (e.g. Cloudflare).
        proxy_ssl_server_name on;

        # Streaming/transcoding responses can be large and slow to start.
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 50m;
    }

    # Single-page app: let React Router handle unknown paths.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
