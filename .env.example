# Copy to .env and adjust. Used by docker-compose.yml.

# The URL of your Navidrome server (no trailing slash), reachable from
# inside the Docker container (not necessarily from the browser - nginx
# proxies to it server-side).
NAVIDROME_URL=https://navidrome.sachaguerin.fr

# Optional: your deemix server, for Discover (search Deezer and download into
# the library). Its download folder must be Navidrome's music folder. Only
# this container talks to it; it never needs to be reachable from browsers.
DEEMIX_URL=
