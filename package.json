{
  "name": "spotifion",
  "productName": "Spotifiak",
  "private": true,
  "version": "0.1.0",
  "description": "A Spotify-styled web client for a self-hosted Navidrome server.",
  "main": "electron/main.mjs",
  "type": "module",
  "updates": {
    "github": "Astri4-4/spotifiak",
    "minShellVersion": "0.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "jam": "node --watch server/jam.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capgo/capacitor-media-session": "^8.1.1",
    "@capgo/capacitor-updater": "^8.52.1",
    "blueimp-md5": "^2.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^3.4.13",
